{
  "name": "cjk-search",
  "version": "0.5.0",
  "private": true,
  "description": "Unicode and OpenCC character equivalence for native Obsidian search",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -p 'test_build_data.py' && node --test tests/*.test.cjs",
    "data:build": "python3 scripts/build_data.py",
    "build": "node scripts/build.cjs",
    "test:native": "node experiments/native-search-spike/run.cjs --plugin-dir dist --full-data",
    "test:surfaces": "node experiments/native-search-spike/run.cjs --plugin-dir dist --surfaces",
    "test:completions": "node experiments/native-search-spike/run.cjs --plugin-dir dist --completions",
    "test:graph": "node experiments/native-search-spike/run.cjs --plugin-dir dist --graph",
    "test:settings": "node experiments/native-search-spike/run.cjs --plugin-dir dist --settings",
    "install:test": "node scripts/install-test.cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
